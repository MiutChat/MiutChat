rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roomData(roomCode) {
      return get(/databases/$(database)/documents/rooms/$(roomCode)).data;
    }

    function memberPath(roomCode, memberId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/members/$(memberId);
    }

    function isRoomMember(roomCode) {
      return isSignedIn() && exists(memberPath(roomCode, request.auth.uid));
    }

    function myMember(roomCode) {
      return get(memberPath(roomCode, request.auth.uid)).data;
    }

    function isApprovedMember(roomCode) {
      return isRoomMember(roomCode)
        && myMember(roomCode).get('approved', false) == true
        && myMember(roomCode).get('blocked', false) != true;
    }

    function isRoomAdmin(roomCode) {
      return isRoomMember(roomCode) && myMember(roomCode).get('role', 'member') == 'admin';
    }

    function isRoomCreator(roomCode) {
      return isSignedIn() && roomData(roomCode).creatorId == request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function messageExpired(roomCode) {
      let ttl = roomData(roomCode).get('msgTtlMs', 0);
      return ttl is number
        && ttl > 0
        && resource.data.createdAt is timestamp
        && request.time.toMillis() > resource.data.createdAt.toMillis() + ttl;
    }

    function isMemberMessageUpdate() {
      return changedKeys().hasOnly(['readBy', 'reactions', 'replyTo'])
        && request.resource.data.get('readBy', {}).diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().size() <= 1
        && (
          !('replyTo' in changedKeys())
          || (
            request.resource.data.replyTo.get('enc', 'x') == null
            && request.resource.data.replyTo.get('deleted', false) == true
          )
        );
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['roomCode','rating','tags','comment','appVersion','createdAt'])
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() > 0 && request.resource.data.roomCode.size() <= 64
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 6
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 32
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /rooms/{roomCode} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasAll(['creatorId','createdAt'])
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.get('salt', null) == resource.data.get('salt', null)
        && (
          isRoomCreator(roomCode)
          || isRoomAdmin(roomCode)
          || (
            isApprovedMember(roomCode)
            && changedKeys().hasOnly(['emptyAt', 'autoDeleteAt', 'lastActivity'])
          )
        );

      allow delete: if isSignedIn() && (isRoomCreator(roomCode) || isRoomAdmin(roomCode));

      match /messages/{msgId} {
        allow read: if isApprovedMember(roomCode);

        allow create: if isApprovedMember(roomCode)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId','createdAt'])
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.keys().hasAll(['enc'])
              && request.resource.data.enc is string
              && request.resource.data.enc.size() <= 8000)
            ||
            (request.resource.data.keys().hasAll(['encData'])
              && request.resource.data.encData is string
              && request.resource.data.encData.size() <= 900000)
          );

        allow update: if isApprovedMember(roomCode)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            resource.data.senderId == request.auth.uid
            || isRoomAdmin(roomCode)
            || isMemberMessageUpdate()
          );

        allow delete: if isApprovedMember(roomCode)
          && (
            resource.data.senderId == request.auth.uid
            || isRoomAdmin(roomCode)
            || messageExpired(roomCode)
          );
      }

      match /members/{memberId} {
        allow read: if isSignedIn() && (request.auth.uid == memberId || isApprovedMember(roomCode));

        allow create: if isSignedIn()
          && request.auth.uid == memberId
          && !(request.auth.uid in roomData(roomCode).get('blockedUsers', []))
          && request.resource.data.keys().hasOnly(['name','color','online','lastSeen','joinedAt','pubKey','role','approved'])
          && request.resource.data.role == 'member'
          && request.resource.data.approved == false
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 64
          && (request.resource.data.pubKey == null || (request.resource.data.pubKey is string && request.resource.data.pubKey.size() <= 4000));

        allow update: if isSignedIn()
          && (
            (
              request.auth.uid == memberId
              && changedKeys().hasOnly(['name','color','online','lastSeen','pubKey'])
            )
            || (
              request.auth.uid == memberId
              && isRoomCreator(roomCode)
              && changedKeys().hasOnly(['role','approved'])
              && request.resource.data.role == 'admin'
              && request.resource.data.approved == true
            )
            || (
              isRoomAdmin(roomCode)
              && changedKeys().hasOnly(['approved','role','declined','blocked','online'])
            )
          );

        allow delete: if isSignedIn() && (request.auth.uid == memberId || isRoomAdmin(roomCode));
      }

      match /typing/{typingId} {
        allow read: if isApprovedMember(roomCode);

        allow create, update: if isApprovedMember(roomCode)
          && request.auth.uid == typingId
          && request.resource.data.keys().hasOnly(['name','ts']);

        allow delete: if isSignedIn() && (request.auth.uid == typingId || isRoomAdmin(roomCode));
      }
    }
  }
}
